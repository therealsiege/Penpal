{
  "mcpServers": {
    "penny": {
      "command": "npx",
      "args": ["tsx", "src/mcp/index.ts"],
      "cwd": "Penny"
    },
    "veritas-kanban": {
      "command": "node",
      "args": ["/Users/cj/SideKick/veritas-kanban/mcp/dist/index.js"],
      "env": {
        "VK_API_URL": "${PENNY_VERITAS_API_URL}",
        "VK_API_KEY": "${PENNY_VERITAS_AGENT_KEY}",
        "VERITAS_ADMIN_KEY": "${PENNY_VERITAS_AGENT_KEY}"
      }
    },
    "graphite-atlas": {
      "command": "npx",
      "args": ["-y", "@graphite-atlas/mcp-server"],
      "env": {
        "GRAPHITE_ACCESS_TOKEN": "${GRAPHITE_ACCESS_TOKEN}",
        "GRAPHITE_API_URL": "https://www.graphiteatlas.com"
      }
    }
  }
}
