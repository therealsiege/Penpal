{
  "mcpServers": {
    "penny": {
      "command": "npx",
      "args": ["tsx", "src/mcp/index.ts"],
      "cwd": "Penny"
    },
    "notion": {
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "OPENAPI_MCP_HEADERS": "${NOTION_MCP_HEADERS}"
      }
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "ddg-search": {
      "command": "uvx",
      "args": ["duckduckgo-mcp-server"]
    },
    "graphite-atlas": {
      "command": "npx",
      "args": ["-y", "@graphite-atlas/mcp-server"],
      "env": {
        "GRAPHITE_ACCESS_TOKEN": "${GRAPHITE_ACCESS_TOKEN}",
        "GRAPHITE_API_URL": "https://www.graphiteatlas.com"
      }
    }
  }
}
