# Copy to Penny/docker/.env.control-plane and customize for your machine.
# This file is a template for Penny's Veritas service manager.

# Docker compose settings
PENNY_DOCKER_PROJECT=penny
PENNY_VERITAS_COMPOSE_FILE=${HOME}/sidekick/Penny/docker/compose.control-plane.yml
PENNY_VERITAS_ENV_FILE=${HOME}/sidekick/Penny/docker/.env.control-plane

# Veritas source/image
PENNY_VERITAS_SOURCE_DIR=${HOME}/veritas-kanban
PENNY_VERITAS_IMAGE=veritas-kanban:local

# Networking
PENNY_VERITAS_BIND_HOST=127.0.0.1
PENNY_VERITAS_PORT=47832
PENNY_VERITAS_API_URL=http://127.0.0.1:47832/api
PENNY_VERITAS_WEB_URL=http://127.0.0.1:47832

# Veritas auth (prefer agent key for runtime operations)
PENNY_VERITAS_AUTH_ENABLED=true
PENNY_VERITAS_LOCALHOST_BYPASS=true
PENNY_VERITAS_LOCALHOST_ROLE=agent
PENNY_VERITAS_ADMIN_KEY=replace-with-strong-admin-key
PENNY_VERITAS_AGENT_KEY=replace-with-agent-key
PENNY_VERITAS_API_KEYS=penny-agent:replace-with-agent-key:agent
PENNY_VERITAS_JWT_SECRET=replace-with-jwt-secret

# Optional
# PENNY_CONTROL_NETWORK=penny_control
# PENNY_VERITAS_DATA_VOLUME=penny_veritas_data
# PENNY_VERITAS_RUNTIME_VOLUME=penny_veritas_runtime
# PENNY_VERITAS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# PENNY_VERITAS_TRUST_PROXY=1
