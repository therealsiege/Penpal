# Penpal analytics — env keys
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# This file (`.env.example`) is committed; `.env` is gitignored.

# ── Graph (Memgraph) ─────────────────────────────────────────────────────
# Defaults match `docker-compose.yml` — only set MEMGRAPH_USER / _PASSWORD
# if you've enabled auth.
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# ── Vector store (Qdrant) ────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── LLM keys ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Web intel + scraping ──────────────────────────────────────────────────
FIRECRAWL_API_KEY=
BRAVE_API_KEY=

# ── Atlas sync (optional — only if you publish to GraphiteAtlas) ─────────
GRAPHITE_API_URL=https://www.graphiteatlas.com
GRAPHITE_ACCESS_TOKEN=
GRAPHITE_ATLAS_NAME=Sidekick Sales

# ── Vault path override (optional) ───────────────────────────────────────
# By default the Vault parser reads from $HOME/sidekick. Override if your
# vault lives elsewhere.
# VAULT_PATH=

# ── NPPES CSV path (optional, NPI enrichment) ────────────────────────────
# Default points at ~/sidekick/Data/NPPES/...
# NPI_FILE_PATH=
