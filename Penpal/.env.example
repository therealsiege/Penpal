# ── Required ───────────────────────────────────────────────────────────────────

# Claude API key — used to run all pod agents (solver, reviewer, executor)
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# GitHub Personal Access Token — needed to poll issues, swap labels, and create PRs
# Scopes required: repo, workflow
# Create at: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...

# ── Optional: Integrations ─────────────────────────────────────────────────────

# Linear API key — enables Linear issue dispatch (poller is silently disabled if unset)
# Create at: https://linear.app/settings/api
# LINEAR_API_KEY=lin_api_...

# Slack bot token — enables the Slack bridge (!task commands, pipeline notifications)
# Create a Slack app at: https://api.slack.com/apps
# SLACK_BOT_TOKEN=xoxb-...

# Slack app-level token — required alongside SLACK_BOT_TOKEN for Socket Mode
# SLACK_APP_TOKEN=xapp-...

# Slack user ID of the workspace owner — used to DM critical alerts
# SLACK_OWNER_USER_ID=U012AB3CD

# Firecrawl API key — used by the analytics pipeline for web scraping / NPI enrichment
# Get one at: https://firecrawl.dev
# FIRECRAWL_API_KEY=fc-...

# OpenAI API key — optional, checked by the health panel to report key status
# OPENAI_API_KEY=sk-...

# ── Optional: Paths ────────────────────────────────────────────────────────────

# Override the default writable data directory (default: ~/.penpal/data)
# PENPAL_DATA_DIR=/custom/path/to/data

# Root of the sidekick monorepo — used to locate the analytics sub-package
# SIDEKICK_ROOT=/path/to/sidekick

# Vault (notes) root directory — overrides the default sidekick vault path
# VAULT_PATH=/path/to/vault

# Docs root — overrides the default documentation directory
# SIDEKICK_DOCS_ROOT=/path/to/docs

# Local path to the Atlas project repo (for GitHub issue auto-dispatch)
# PENNY_ATLAS_ROOT=/path/to/atlas

# Local path to the sidekick repo root (used by project-paths helpers)
# PENNY_SIDEKICK_ROOT=/path/to/sidekick

# ── Optional: Agent Runner ─────────────────────────────────────────────────────

# Task runner backend — controls which agent binary runs pods
# Values: claude (default) | opencode | cursor-agent
# PENNY_TASK_RUNNER=claude

# Per-phase runner overrides (planning / executing / validating stages)
# PENNY_TASK_RUNNER_PLAN=claude
# PENNY_TASK_RUNNER_EXECUTE=claude
# PENNY_TASK_RUNNER_VALIDATE=claude

# Retry any failed pod stage automatically (set to "1" to enable)
# PENNY_TASK_RUNNER_RETRY_ANY_FAILURE=1

# ── Optional: Ollama (local LLM) ───────────────────────────────────────────────

# Base URL for a local Ollama instance (used as an alternative agent backend)
# PENNY_OLLAMA_BASE_URL=http://localhost:11434

# API key for a remote Ollama-compatible endpoint (leave unset for local instances)
# PENNY_OLLAMA_API_KEY=

# Default Ollama model to use when running agent tasks via Ollama
# PENNY_OLLAMA_MODEL=qwen3-coder:30b

# ── Optional: Cursor Agent ────────────────────────────────────────────────────

# Path or name of the Cursor agent binary (default: "agent" on $PATH)
# PENNY_CURSOR_AGENT_BIN=agent

# Cursor API key — required when PENNY_TASK_RUNNER=cursor-agent
# CURSOR_API_KEY=...

# ── Optional: Database (analytics sub-package) ────────────────────────────────

# Memgraph connection URI (default: bolt://localhost:7687)
# MEMGRAPH_URI=bolt://localhost:7687

# Memgraph credentials (leave blank if auth is disabled)
# MEMGRAPH_USER=
# MEMGRAPH_PASSWORD=

# Qdrant vector DB URL (default: http://localhost:6333)
# QDRANT_URL=http://localhost:6333

# ── Optional: Misc ─────────────────────────────────────────────────────────────

# Prefix for Slack channel names created by the fleet heartbeat / bridge (default: sk)
# SLACK_CHANNEL_PREFIX=sk

# Set to "true" to automatically archive inactive Slack channels
# SLACK_ARCHIVE_INACTIVE_CHANNELS=false

# Override the control-plane .env file path (docker/.env.control-plane by default)
# PENNY_VERITAS_ENV_FILE=/path/to/.env.control-plane

# Directory containing custom sound effect files for the Penpal soundboard
# PENNY_SFX_DIR=/path/to/sfx
