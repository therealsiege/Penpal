{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../src/main/**/*.test.ts",
    "../src/mcp/**/*.test.ts",
    "../src/renderer/**/*.test.ts",
    "../src/renderer/**/*.test.tsx"
  ]
}
