{
  "name": "penpal",
  "productName": "Penpal",
  "version": "0.3.2",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "icon:generate": "node scripts/generate-icon.mjs",
    "sprites": "node scripts/build-sprites.mjs",
    "sprites:icons": "node scripts/build-game-icons.mjs",
    "sprites:all": "node scripts/build-all-sprites.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test --project=e2e",
    "test:e2e:headed": "npx playwright test --headed --project=e2e",
    "test:e2e:lab-layout": "npx playwright test tests/lab-layout-visual.spec.ts --project=e2e",
    "test:visual": "npx playwright test --project=visual",
    "test:visual:update": "VISUAL_UPDATE=1 npx playwright test --project=visual",
    "mcp:start": "npx tsx src/mcp/index.ts",
    "pod:create": "node --import tsx src/main/pod-cli.ts",
    "test:spot-check": "npx tsx --test src/main/evals/__tests__/human-judge.test.ts",
    "typecheck": "tsc --noEmit",
    "package": "electron-vite build && electron-forge package",
    "make": "electron-vite build && electron-forge make",
    "publish": "electron-vite build && electron-forge publish",
    "release": "scripts/release.sh"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@slack/bolt": "^4.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "dotenv": "^17.3.1",
    "electron-updater": "^6.8.3",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "minisearch": "^7.2.0",
    "neo4j-driver": "^5.27.0",
    "node-pty": "^1.1.0",
    "phaser": "^3.90.0",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.8.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@playwright/test": "^1.58.2",
    "@types/js-yaml": "^4.0.9",
    "@types/pixelmatch": "^5.2.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.0.1",
    "pixelmatch": "^7.1.0",
    "playwright-core": "^1.58.2",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2"
  }
}
